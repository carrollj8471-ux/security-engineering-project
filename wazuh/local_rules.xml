<!--
  Local Wazuh rule examples for the Active Directory Attack and Defense Lab.
  Place vetted rules in /var/ossec/etc/rules/local_rules.xml on the Wazuh Manager.
  Rule IDs in the 100000-100199 range are reserved here for portfolio lab examples.
-->
<group name="windows,sysmon,attack_detection_lab,">

  <rule id="100001" level="7">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image">\\systeminfo.exe$|\\tasklist.exe$|\\whoami.exe$|\\ipconfig.exe$|\\netstat.exe$</field>
    <description>Discovery utility executed on Windows endpoint</description>
    <mitre>
      <id>T1082</id>
      <id>T1057</id>
      <id>T1033</id>
      <id>T1016</id>
      <id>T1049</id>
    </mitre>
  </rule>

  <rule id="100002" level="9">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image">\\powershell.exe$|\\pwsh.exe$</field>
    <field name="win.eventdata.commandLine">EncodedCommand|ExecutionPolicy Bypass|DownloadString|Invoke-WebRequest</field>
    <description>Suspicious PowerShell command line observed</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <rule id="100003" level="10">
    <if_group>sysmon_event13</if_group>
    <field name="win.eventdata.targetObject">\\CurrentVersion\\Run</field>
    <description>Registry Run key modified</description>
    <mitre>
      <id>T1547.001</id>
      <id>T1112</id>
    </mitre>
  </rule>

  <rule id="100004" level="12">
    <if_group>windows_security</if_group>
    <field name="win.system.eventID">4728|4732|4756</field>
    <description>Security-enabled group membership changed</description>
    <mitre>
      <id>T1098</id>
      <id>T1078</id>
    </mitre>
  </rule>

  <rule id="100005" level="10">
    <if_group>windows_security</if_group>
    <field name="win.system.eventID">4720</field>
    <description>New Active Directory user account created</description>
    <mitre>
      <id>T1136.002</id>
    </mitre>
  </rule>

  <rule id="100006" level="8" frequency="5" timeframe="300">
    <if_group>windows_security</if_group>
    <field name="win.system.eventID">4625</field>
    <description>Multiple failed Windows logons observed within five minutes</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

</group>
