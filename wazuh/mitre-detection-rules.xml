<group name="windows, sysmon, mitre, custom,">
<!-- T1082: System Information Discovery -->
  <rule id="100201" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(systeminfo|hostname)\.exe$</field>
    <description>MITRE T1082 - System information discovery tool executed</description>
    <mitre>
      <id>T1082</id>
    </mitre>
    <group>discovery,system_information_discovery,</group>
  </rule>

  <!-- T1082: Registry-based operating-system discovery -->
  <rule id="100202" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)reg(\.exe)?\s+query.+\\Windows NT\\CurrentVersion|CurrentBuildNumber|ProductName|MachineGuid</field>
    <description>MITRE T1082 - Windows system information queried from registry</description>
    <mitre>
      <id>T1082</id>
    </mitre>
    <group>discovery,system_information_discovery,registry_query,</group>
  </rule>

  <!-- T1016: System Network Configuration Discovery -->
  <rule id="100203" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(ipconfig|arp|route|netsh)\.exe$</field>
    <description>MITRE T1016 - System network configuration discovery</description>
    <mitre>
      <id>T1016</id>
    </mitre>
    <group>discovery,network_configuration_discovery,</group>
  </rule>

  <rule id="100181" level="8">
    <if_sid>92032</if_sid>
    <field name="win.eventdata.image"
           type="pcre2">(?i)\\nbtstat\.exe$</field>
    <field name="win.eventdata.commandLine"
           type="pcre2">(?i)\s-n(?:\s|$)</field>
    <description>Local NetBIOS configuration enumerated with nbtstat</description>
    <mitre>
      <id>T1016</id>
    </mitre>
    <group>discovery,network_configuration_discovery,</group>
  </rule>

  <rule id="100182" level="8">
    <if_sid>92036</if_sid>
    <field name="win.eventdata.image"
           type="pcre2">(?i)\\net\.exe$</field>
    <field name="win.eventdata.commandLine"
           type="pcre2">(?i)\bconfig\b</field>
    <description>Windows network configuration enumerated with net.exe</description>
    <mitre>
      <id>T1016</id>
    </mitre>
    <group>discovery,network_configuration_discovery,</group>
  </rule>

  <!-- T1049: System Network Connections Discovery -->
  <rule id="100204" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\netstat\.exe$</field>
    <description>MITRE T1049 - System network connections discovery</description>
    <mitre>
      <id>T1049</id>
    </mitre>
    <group>discovery,network_connection_discovery,</group>
  </rule>

  <!-- T1057: Process Discovery -->
  <rule id="100205" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(tasklist|wmic)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(tasklist|wmic(\.exe)?\s+process)</field>
    <description>MITRE T1057 - Process discovery performed</description>
    <mitre>
      <id>T1057</id>
    </mitre>
    <group>discovery,process_discovery,</group>
  </rule>
  <rule id="100170" level="7">
    <if_sid>100205</if_sid>
    <field name="win.eventdata.image"
           type="pcre2">(?i)\\tasklist\.exe$</field>
    <field name="win.eventdata.commandLine"
           type="pcre2">(?i)\s/svc(?:\s|$)</field>
    <description>Windows services enumerated with tasklist</description>
    <mitre>
      <id>T1007</id>
    </mitre>
    <group>discovery,service_discovery,</group>
  </rule>

  <rule id="100171" level="7">
    <if_sid>92032</if_sid>
    <field name="win.eventdata.image"
           type="pcre2">(?i)\\sc\.exe$</field>
    <field name="win.eventdata.commandLine"
           type="pcre2">(?i)\bquery\b</field>
    <description>Windows services enumerated with sc.exe</description>
    <mitre>
      <id>T1007</id>
    </mitre>
    <group>discovery,service_discovery,</group>
  </rule>

  <!-- T1087: Account Discovery -->
  <rule id="100206" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(whoami(\.exe)?|net1?(\.exe)?\s+(user|localgroup)|query(\.exe)?\s+user)</field>
    <description>MITRE T1087 - Local or domain account discovery</description>
    <mitre>
      <id>T1087</id>
    </mitre>
    <group>discovery,account_discovery,</group>
  </rule>

  <!-- T1018: Remote System Discovery -->
  <rule id="100207" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(net1?(\.exe)?\s+view|nltest(\.exe)?.*/dclist|ping(\.exe)?\s+)</field>
    <description>MITRE T1018 - Remote system discovery command executed</description>
    <mitre>
      <id>T1018</id>
    </mitre>
    <group>discovery,remote_system_discovery,</group>
  </rule>

  <!-- T1059.003: Windows Command Shell -->
  <rule id="100208" level="9">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\cmd\.exe$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\powershell(_ise)?\.exe$</field>
    <description>MITRE T1059.003 - PowerShell launched Windows command shell</description>
    <mitre>
      <id>T1059.003</id>
    </mitre>
    <group>execution,command_shell,powershell_parent,</group>
  </rule>

  <rule id="100180" level="8">
    <if_sid>100208</if_sid>
    <field name="win.eventdata.commandLine"
           type="pcre2">(?i)\bnetsh(?:\.exe)?\s+interface\s+show\b</field>
    <description>Windows network interfaces enumerated with netsh</description>
    <mitre>
      <id>T1016</id>
    </mitre>
    <group>discovery,network_configuration_discovery,</group>
  </rule>

  <rule id="100190" level="10">
    <if_sid>100208</if_sid>
    <field name="win.eventdata.commandLine"
           type="pcre2">(?i)ADMIN</field>
    <description>Windows administrative share accessed through a UNC path</description>
    <mitre>
      <id>T1021.002</id>
    </mitre>
    <group>lateral_movement,remote_services,smb_admin_share,</group>
  </rule>

  <!-- T1105: Ingress Tool Transfer -->
  <rule id="100209" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(certutil(\.exe)?.*(https?|urlcache)|bitsadmin(\.exe)?.*https?|invoke-webrequest|iwr\s+https?|curl(\.exe)?\s+.*https?)</field>
    <description>MITRE T1105 - Command-line download utility used</description>
    <mitre>
      <id>T1105</id>
    </mitre>
    <group>command_and_control,ingress_tool_transfer,download_utility,</group>
  </rule>

  <!-- T1218: Signed Binary Proxy Execution -->
  <rule id="100210" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(regsvr32|rundll32|installutil|msbuild|mshta)\.exe$</field>
    <description>MITRE T1218 - Windows signed binary proxy execution</description>
    <mitre>
      <id>T1218</id>
    </mitre>
    <group>defense_evasion,signed_binary_proxy_execution,lolbin,</group>
  </rule>

  <!-- T1218.011: Rundll32 -->
  <rule id="100152" level="12">
    <if_sid>100210</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)rundll32\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(Control_RunDLL|,[A-Za-z_][A-Za-z0-9_]*|,#[0-9]+|javascript:|\.cpl(?:\s|$))</field>
    <description>Rundll32 invoked for DLL entry-point or Control Panel proxy execution</description>
    <mitre>
      <id>T1218.011</id>
    </mitre>
    <group>defense_evasion,signed_binary_proxy_execution,rundll32,</group>
  </rule>
</group>
